rules_version = '2';

// 우교청 Firestore 보안 규칙
//
// 설계 원칙:
// - 읽기: 이 앱은 작은 청년부 커뮤니티용이고, 홈 화면 배지/실적 대시보드 등
//   여러 화면이 역할과 무관하게 전체 컬렉션을 구독하므로, 로그인한 사용자라면
//   대부분의 컬렉션을 폭넓게 읽을 수 있게 했다. 대신 "쓰기"를 역할별로 엄격히 제한해
//   변조·권한 상승을 막는 데 집중한다.
// - 계정 생성은 Google 로그인만 지원한다(이메일/비밀번호로 실제 가입하는 경로는
//   앱에 없음). 최초 로그인 시 본인 uid로, role=member/department='' 상태로만
//   스스로 users 문서를 만들 수 있다.
// - role 필드(권한 승급)는 반드시 관리자(admin/pastor)만 바꿀 수 있다. 클라이언트
//   UI는 소팀장 이상이면 아무 회원의 role이나 바꿀 수 있게 되어 있지만(멤버 관리
//   화면), 실제 배포에서는 이를 그대로 허용하지 않고 서버 규칙에서 더 엄격하게
//   막았다 — 이름/연락처/소속팀 등 일반 정보는 소팀장 이상이 계속 관리할 수 있다.
// - testing@church.com 계정은 QA 목적으로 본인 role만 스스로 전환할 수 있게 예외를
//   둔다(프로필 화면의 "테스트 계정 - 역할 전환" 기능과 짝을 이룸). 이 예외가 안전하려면
//   실제로 그 계정이 먼저 만들어져 있어야 한다(Firebase Auth는 프로젝트 내 이메일 유일성을
//   보장하므로, 규칙 배포와 함께/직후에 이 계정을 만들어 선점해 둘 것).
// - 신규 가입 온보딩(소속팀 최초 등록), 콘텐츠팀 팀장의 배너 권한 위임처럼 본인
//   role을 유지한 채 자기 문서 또는 특정 조건의 타인 문서를 갱신해야 하는 정상
//   흐름을 위한 예외를 users 컬렉션에 별도로 뒀다. 역할 양도(transferRole)는
//   목사님만 가능하며, 목사님은 isAdmin()으로 이미 모든 users 문서 쓰기가
//   허용되므로 별도 예외가 필요 없다(두 문서 update를 하나의 WriteBatch로 묶어
//   수행하며, get()은 배치 적용 전 상태를 보므로 목사님 본인 강등 쓰기도 통과됨).
// - 알려진 단순화: 소팀장이 "본인 소팀"만 수정할 수 있어야 하는 세부 제약(부서 일치
//   검사)은 여기서 강제하지 않았다. 지금은 소팀장 이상이면 누구나 출석/회비/명단을
//   수정할 수 있다 — 다른 팀 기록까지 건드릴 수 있다는 뜻이므로, 추후 부서 일치
//   검사를 추가하는 것을 권장한다.
// - positions(자리): 권한을 사람이 아니라 "자리"(예: A-1 소팀장)에 붙여, holder
//   교체 한 번으로 전임자 강등까지 끝나도록 한 모델(23차 작업). 자리 문서 자체는
//   관리자만 쓸 수 있고 capacity(단일석=1/다인석=null) 불변식만 검사한다. "자리가
//   바뀌면 users.role/department도 같은 배치에서 일치해야 한다"는 더 강한 교차
//   검증(getAfter 활용)은 검토했으나, 관리자는 이미 users 전체에 대한 쓰기 권한이
//   있어(isAdmin()) positions 쪽만 따로 더 막아도 공격 표면이 줄지 않아 생략했다 —
//   원자성(같은 WriteBatch로 묶기)은 서버 규칙이 아니라 FirestoreService 쪽
//   책임으로 유지한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 역할 판정 헬퍼 ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }

    function isRegistered() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPastor() { return isRegistered() && myData().role == 'pastor'; }
    function isAdmin() { return isRegistered() && myData().role in ['admin', 'pastor']; }
    function isExecutive() { return isAdmin() || (isRegistered() && myData().role == 'executive'); }
    function isMidLeader() { return isExecutive() || (isRegistered() && myData().role == 'mid_leader'); }
    function isSmallLeader() { return isMidLeader() || (isRegistered() && myData().role == 'small_leader'); }

    function isTestAccount() { return isSignedIn() && request.auth.token.email == 'testing@church.com'; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // lib/providers/auth_provider.dart의 canManageBanners와 동일한 조건
    function canManageBanners() {
      return isExecutive() ||
        (isRegistered() && myData().ministryTeam == '콘텐츠팀' &&
         (myData().isMinistryLead == true || myData().bannerAccessGranted == true));
    }
    // 콘텐츠팀 팀장(role은 member) — 팀원의 사역팀 소속/배너 권한 위임을 관리할 수 있음
    function isContentTeamLead() {
      return isRegistered() && myData().ministryTeam == '콘텐츠팀' && myData().isMinistryLead == true;
    }

    // ── users 쓰기 헬퍼 ────────────────────────────────────────────────
    // 필드가 없는 예전 문서도 있으므로 get(키, 기본값)으로 비교한다
    function unchanged(key, defaultValue) {
      return request.resource.data.get(key, defaultValue) == resource.data.get(key, defaultValue);
    }
    // 불리언 권한 플래그는 그대로 두거나 false로 내리는 것(해제)만 허용
    function notRaised(key) {
      return unchanged(key, false) || request.resource.data.get(key, false) == false;
    }
    // users 문서에 앱(UserModel.toMap)이 쓰는 필드만 허용 — 정의되지 않은 필드를
    // 끼워 넣어 두면 나중에 같은 이름의 권한 필드가 추가될 때 그대로 권한이
    // 되므로, 관리자 외의 생성·온보딩에서는 막아 둔다(28차 작업 보안 점검 N6).
    // toMap에 필드를 추가하면 여기에도 같이 추가해야 함
    function userKeys() {
      return ['name', 'email', 'phone', 'role', 'department', 'joinDate', 'profileImageUrl',
        'permissions', 'newFamilyGraduatedTo', 'ministryTeam', 'executiveTitle',
        'isMinistryLead', 'bannerAccessGranted', 'birthDate', 'cohort'];
    }
    function hasOnlyUserKeys() {
      return request.resource.data.keys().hasOnly(userKeys());
    }
    // 수정에서는 "새로 바뀌거나 추가되는 필드"만 검사 — 콘솔 등으로 예전에 들어간
    // 다른 필드가 남아 있는 문서도 계속 수정할 수 있게 한다(S3)
    function changesOnlyUserKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys());
    }
    // 새로 만드는 users 문서가 권한 필드를 들고 생기지 않게 한다 — 임원팀 직책·
    // permissions는 비어 있고 사역팀장 플래그는 false. 배너 위임만은 콘텐츠팀
    // 팀장이 콘텐츠팀원을 회원 추가 화면에서 만들 때 허용(update 규칙과 같은 범위)
    function createsNoPrivilege() {
      return hasOnlyUserKeys() &&
        request.resource.data.get('permissions', []) == [] &&
        request.resource.data.get('executiveTitle', '') == '' &&
        request.resource.data.get('isMinistryLead', false) == false &&
        (request.resource.data.get('bannerAccessGranted', false) == false ||
         (isContentTeamLead() && request.resource.data.get('ministryTeam', '') == '콘텐츠팀'));
    }

    // ── users ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();
      // Google 최초 로그인 시 본인 uid로 role=member/department='' 상태로만 스스로
      // 생성 가능. 그 외(CSV 일괄 가져오기, 관리자가 미리 명단 등록 등)는 소팀장
      // 이상이 대행 생성 — 단, 소팀장 이상이 대행 생성할 때도 role은 'member'로만
      // 제한한다(그러지 않으면 소팀장이 role: 'admin'인 새 문서를 직접 만들어
      // 권한을 스스로 획득할 수 있음 — update 규칙은 이미 role 변경을 관리자로
      // 제한하지만 create는 신규 문서라 그 제약을 타지 않았던 구멍, 23차 작업
      // 보안 점검에서 발견). 본인 생성은 사역팀도 비어 있어야 하고, 두 분기 모두
      // 권한 필드를 들고 생성할 수 없다(createsNoPrivilege) — 그러지 않으면 본인
      // 문서를 삭제(회원 탈퇴)한 뒤 콘텐츠팀장·배너 권한을 넣어 다시 만들어 F3
      // 수정을 우회할 수 있었음(28차 작업)
      // 본인 생성의 email은 실제 로그인 계정 이메일과 같아야 함 — 남의 이메일을
      // 적어 두면 리더 명단 엑셀(이메일로 회원을 찾음)로 그 사람 대신 승급될 수
      // 있었음(28차 작업 보안 점검 S1). 앱은 처음부터 firebaseUser.email(없으면
      // '')을 그대로 쓴다
      allow create: if isAdmin() ||
        (isSmallLeader() && request.resource.data.role == 'member' && createsNoPrivilege()) ||
        (isOwner(uid) && request.resource.data.role == 'member' && request.resource.data.department == '' &&
         request.resource.data.get('ministryTeam', '') == '' && createsNoPrivilege() &&
         request.resource.data.get('email', '') == request.auth.token.get('email', '') &&
         // 이메일/비밀번호 가입은 인증 메일 없이도 아무 이메일로 만들 수 있으므로,
         // 이메일을 적으려면 인증된 이메일(Google 로그인은 항상 인증됨)이어야 함(재검토 B1)
         (request.resource.data.get('email', '') == '' ||
          request.auth.token.get('email_verified', false) == true || isTestAccount()));
      allow update: if
        // 일반 정보(이름/연락처/소속팀/사역팀 등) 수정: 소팀장 이상, role·permissions는 그대로.
        // 임원팀 직책·사역팀장·배너 권한 위임은 앱에서 관리자(배너 위임은 콘텐츠팀
        // 팀장도)만 지정하므로 여기서는 올릴 수 없고 해제만 가능 — 그러지 않으면
        // 소팀장이 SDK로 자기 문서에 콘텐츠팀장을 써서 배너 권한을 얻을 수 있었음
        // (26차 작업 보안 점검 F3). 사역팀을 옮길 때도 팀장/위임 플래그를 들고
        // 갈 수 없게 함(앱도 사역팀 해제 시 두 플래그를 같이 내림)
        // permissions는 필드가 없는 예전 문서도 수정할 수 있게 get 기본값으로 비교(28차 작업).
        // 사역팀장 지정·해임은 관리자만이므로 isMinistryLead는 아예 바꿀 수 없고(S2),
        // 앱이 쓰지 않는 필드를 새로 끼워 넣을 수도 없다(S3)
        (isSmallLeader() && request.resource.data.role == resource.data.role &&
         changesOnlyUserKeys() &&
         unchanged('permissions', []) &&
         unchanged('executiveTitle', '') &&
         unchanged('isMinistryLead', false) && notRaised('bannerAccessGranted') &&
         (unchanged('ministryTeam', '') ||
          (request.resource.data.get('isMinistryLead', false) == false &&
           request.resource.data.get('bannerAccessGranted', false) == false))) ||
        // role 변경(승급/강등)은 관리자만 — 역할 양도(transferRole)도 목사님만
        // 가능하므로 여기 isAdmin()으로 이미 커버됨(별도 예외 불필요)
        isAdmin() ||
        // QA 테스트 계정은 본인 role을 스스로 전환 가능
        (isTestAccount() && isOwner(uid)) ||
        // 신규 가입 온보딩: 방금 만든 본인 문서(department가 비어있던 상태)에 소속팀 등
        // 정보를 처음 채우는 것만 허용, role은 member로 유지
        // (온보딩 화면은 이름·소속팀·생년월일·기수만 채움 — 권한 관련 필드는 그대로).
        // 소속팀은 온보딩 화면 목록(AppTeams.smallTeams)에서만 고를 수 있고 기수는
        // 숫자 필수 — 그러지 않으면 탈퇴 후 재가입하면서 '임원팀' 같은 소속이나
        // 빈 기수로 기수 이용 제한을 피할 수 있었음(28차 작업 보안 점검 N5)
        // email은 가입 때 정해진 로그인 이메일 그대로(S1)
        (isOwner(uid) && resource.data.role == 'member' && request.resource.data.role == 'member' &&
         resource.data.department == '' && unchanged('email', '') &&
         request.resource.data.department in [
           'A-1', 'A-2', 'A-3', 'A-4', 'B-1', 'B-2', 'B-3', 'B-4',
           'C-1', 'C-2', 'C-3', 'C-4', 'D-1', 'D-2', 'D-3', 'D-4', '새가족팀'] &&
         request.resource.data.get('cohort', null) is int && hasOnlyUserKeys() &&
         unchanged('permissions', []) && unchanged('executiveTitle', '') && unchanged('ministryTeam', '') &&
         unchanged('isMinistryLead', false) && unchanged('bannerAccessGranted', false)) ||
        // 콘텐츠팀 팀장이 팀원의 사역팀 소속 해제/배너 권한 위임을 관리 — 콘텐츠팀
        // 소속 회원의 사역팀 관련 필드만 바꿀 수 있다(이전에는 role만 고정돼 있어
        // 아무 회원의 소속팀·직책·permissions까지 수정 가능했음, F3). 앱은 문서
        // 전체를 update하므로 예전 문서에 없던 선택 필드가 기본값으로 새로 써지는
        // 경우는 허용한다. 다른 사역팀장은 대상이 아니고(팀장 지정·해임은 관리자만),
        // 사역팀에서 빼는 회원의 배너 위임은 함께 내려야 한다(남겨 두면 나중에
        // 콘텐츠팀으로 돌아올 때 권한이 조용히 되살아남) — 28차 작업 보안 점검 N1·N2
        (isContentTeamLead() &&
         resource.data.get('ministryTeam', '') == '콘텐츠팀' &&
         request.resource.data.get('ministryTeam', '') in ['콘텐츠팀', ''] &&
         resource.data.get('isMinistryLead', false) == false &&
         unchanged('isMinistryLead', false) &&
         (request.resource.data.get('ministryTeam', '') == '콘텐츠팀' ||
          request.resource.data.get('bannerAccessGranted', false) == false) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'ministryTeam', 'isMinistryLead', 'bannerAccessGranted',
           'permissions', 'executiveTitle', 'birthDate', 'cohort', 'profileImageUrl', 'newFamilyGraduatedTo']) &&
         unchanged('permissions', []) && unchanged('executiveTitle', '') && unchanged('birthDate', null) &&
         unchanged('cohort', null) && unchanged('profileImageUrl', null) && unchanged('newFamilyGraduatedTo', null));
      // 본인 문서 삭제는 회원 탈퇴(스토어 정책상 필수) 용도 — 앱은 목사님 본인 탈퇴를 UI에서
      // 막고 먼저 역할 양도를 안내함. 소팀장 이상이 지울 수 있는 건 사역팀장·배너
      // 위임이 없는 일반 팀원뿐 — 그러지 않으면 다른 소팀장 문서를 지우고 member로
      // 다시 만들어 사실상 강등시킬 수 있었음(역할 변경은 관리자만, 28차 작업 N4)
      allow delete: if isAdmin() ||
        (isSmallLeader() && resource.data.get('role', 'member') == 'member' &&
         resource.data.get('isMinistryLead', false) == false &&
         resource.data.get('bannerAccessGranted', false) == false) ||
        isOwner(uid);
    }

    // ── positions (자리: 소팀장/중팀장/임원팀) ──────────────────────────
    // capacity==1(단일석)이면 holderUids는 0~1명만 허용. capacity==null(다인석,
    // 임원팀·새가족팀 리더)은 인원 제한을 두지 않는다
    function positionCapacityOk() {
      return request.resource.data.capacity == null ||
        request.resource.data.holderUids.size() <= request.resource.data.capacity;
    }
    match /positions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && positionCapacityOk();
    }

    // ── leaderRosterUploads: 리더 명단 엑셀 업로드 시 원본 파일을 30일간
    // 보관(Firestore TTL로 expiresAt 지난 문서 자동 삭제, Storage는 Spark
    // 요금제라 미사용) — 관리자만 접근
    match /leaderRosterUploads/{id} {
      allow read, create, delete: if isAdmin();
    }

    // ── attendance / fees: 본인 기록은 스스로 기록, 그 외는 소팀장 이상 ──
    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow create: if isSmallLeader() || isOwner(request.resource.data.userId);
      allow update: if isSmallLeader() ||
        (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId);
      allow delete: if isSmallLeader();
    }
    match /fees/{docId} {
      allow read: if isSignedIn();
      allow create: if isSmallLeader() || isOwner(request.resource.data.userId);
      allow update: if isSmallLeader() ||
        (isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId);
      allow delete: if isSmallLeader();
    }

    // ── visits (심방 신청) ────────────────────────────────────────────
    // 심방 사유·연락처 등 민감한 개인정보를 담고 있어, 다른 컬렉션과 달리
    // "로그인했으면 폭넓게 읽기 허용"하는 전역 원칙의 예외로 둠 — 본인 신청
    // 내역 또는 목사님만 읽을 수 있다(앱 UI도 동일하게 isPastor로 분기)
    match /visits/{visitId} {
      allow read: if isOwner(resource.data.userId) || isPastor();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isPastor();
      allow delete: if isPastor();
    }
    match /visitSlots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isSmallLeader();
    }

    // ── newFamilyRotations / ministryMeetings ────────────────────────
    match /newFamilyRotations/{id} {
      allow read: if isSignedIn();
      allow write: if isSmallLeader();
    }
    match /ministryMeetings/{id} {
      allow read: if isSignedIn();
      allow write: if isSmallLeader();
    }

    // ── notifications: 본인 것만 읽고 읽음 처리 가능 ───────────────────
    match /notifications/{id} {
      allow read, update: if isOwner(resource.data.userId);
      // 다른 사람에게 알림을 보내는 것은 항상 소팀장 이상의 동작(심방 승인, 팀
      // 배정, 새가족 로테이션 배정 등)에서만 발생함
      allow create: if isSmallLeader();
      allow delete: if false;
    }

    // ── banners ────────────────────────────────────────────────────
    match /banners/{id} {
      allow read: if isSignedIn();
      allow write: if canManageBanners();
    }
  }
}
